{
  "rules": {
    "sisventas": {
      ".read": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true) && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'",
      ".write": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true) && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'",
      "chat": {
        ".validate": false
      },
      "usuarios": {
        ".validate": false
      },
      "config": {
        "permisos": {
          ".validate": false
        }
      },
      "productos": {
        ".indexOn": [
          "categoria"
        ],
        ".read": "auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'compras_paraguay' && query.orderByChild === 'categoria' && query.equalTo === 'COMPRAS PARAGUAY'"
      }
    },
    "sv_borradores": {
      "$uid": {
        ".read": "(auth != null && auth.uid === $uid) && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'",
        ".write": "(auth != null && auth.uid === $uid) && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'",
        "$id": {
          ".validate": "newData.hasChildren(['id','updated']) && newData.child('id').val() === $id && newData.child('updated').isNumber() && (newData.child('deleted').val() === true || (data.child('deleted').val() !== true && newData.child('schema').val() === 1 && newData.hasChild('data') && (newData.child('kind').val() === 'venta' || newData.child('kind').val() === 'presupuesto')))"
        }
      }
    },
    "sv_ia_reglas": {
      ".read": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true) && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'",
      ".write": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin') && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'",
      "$id": {
        ".validate": "newData.hasChildren(['categoria','codigo','cantidad','activa','actualizadaEn','autor']) && newData.child('categoria').isString() && newData.child('codigo').isString() && newData.child('cantidad').isNumber() && newData.child('cantidad').val() > 0 && newData.child('activa').isBoolean()"
      }
    },
    "sv_rrhh_adjuntos": {
      ".read": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin') && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'",
      ".write": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin') && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'"
    },
    "sv_chat_roles": {
      ".read": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin') && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'",
      ".write": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin') && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "sv_chat_directorio": {
      ".read": "(auth != null) && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'",
      ".write": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin') && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'"
    },
    "sv_chat": {
      "$canal": {
        ".read": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && ($canal === 'general' || ($canal === 'admin' && (root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'administrativo' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'vendedor' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'tecnico_vendedor')) || ($canal === 'tecnicos' && (root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'tecnico' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'tecnico_vendedor')) || $canal.beginsWith('directo_' + auth.uid + '_') || $canal.endsWith('_' + auth.uid) || ($canal.beginsWith('archivo_') && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin'))) && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'",
        ".write": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && ($canal === 'general' || ($canal === 'admin' && (root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'administrativo' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'vendedor' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'tecnico_vendedor')) || ($canal === 'tecnicos' && (root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'tecnico' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'tecnico_vendedor')) || $canal.beginsWith('directo_' + auth.uid + '_') || $canal.endsWith('_' + auth.uid) || ($canal.beginsWith('archivo_') && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin'))) && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'"
      }
    },
    "sv_chat_escribiendo": {
      "$canal": {
        ".read": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && ($canal === 'general' || ($canal === 'admin' && (root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'administrativo' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'vendedor' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'tecnico_vendedor')) || ($canal === 'tecnicos' && (root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'tecnico' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'tecnico_vendedor')) || $canal.beginsWith('directo_' + auth.uid + '_') || $canal.endsWith('_' + auth.uid) || ($canal.beginsWith('archivo_') && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin'))) && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'",
        ".write": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && ($canal === 'general' || ($canal === 'admin' && (root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'administrativo' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'vendedor' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'tecnico_vendedor')) || ($canal === 'tecnicos' && (root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'tecnico' || root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'tecnico_vendedor')) || $canal.beginsWith('directo_' + auth.uid + '_') || $canal.endsWith('_' + auth.uid) || ($canal.beginsWith('archivo_') && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin'))) && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'"
      }
    },
    "sv_usuarios": {
      ".read": "((auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true) && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay') || (auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'compras_paraguay' && query.orderByChild === 'uid' && query.equalTo === auth.uid)",
      ".write": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin') && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'",
      "$usuario": {
        "ultimoAcceso": {
          ".write": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && data.parent().child('uid').val() === auth.uid) && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 300000"
        },
        "ultimoAccesoEn": {
          ".write": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && data.parent().child('uid').val() === auth.uid) && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 300000"
        }
      },
      ".indexOn": [
        "uid"
      ]
    },
    "sv_permisos": {
      ".read": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true) && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'",
      ".write": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin') && root.child('sv_chat_roles').child(auth.uid).child('rol').val() !== 'compras_paraguay'"
    },
    "sv_listas_paraguay": {
      "$uid": {
        ".read": "auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && (root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin' || (auth.uid === $uid && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'compras_paraguay'))",
        "$lista": {
          ".write": "auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && (root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin' || (root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'compras_paraguay' && auth.uid === $uid))",
          ".validate": "newData.hasChildren(['nombre','productos','actualizadoEn'])",
          "nombre": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
          },
          "actualizadoEn": {
            ".validate": "newData.isNumber() && newData.val() <= now + 300000 && newData.val() >= 0"
          },
          "productos": {
            ".validate": "newData.hasChildren()",
            "$producto": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 9999 && newData.val() % 1 === 0 && root.child('sisventas/productos').child($producto).child('categoria').val() === 'COMPRAS PARAGUAY' && root.child('sisventas/productos').child($producto).child('activo').val() !== false && root.child('sisventas/productos').child($producto).child('estado').val() !== 'Inactivo' && root.child('sisventas/productos').child($producto).child('esManoDeObra').val() !== true"
            }
          },
          "$otro": {
            ".validate": false
          },
          "comprasFinales": {
            "$producto": {
              ".validate": "newData.parent().parent().child('productos').child($producto).exists() && newData.hasChildren(['cantidad','precioUnitario','moneda','proveedor'])",
              "cantidad": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999 && newData.val() % 1 === 0"
              },
              "precioUnitario": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
              },
              "moneda": {
                ".validate": "newData.isString() && (newData.val() === 'USD' || newData.val() === 'ARS' || newData.val() === 'PYG')"
              },
              "proveedor": {
                ".validate": "newData.isString() && newData.val().length <= 120"
              },
              "$otro": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}
