    "sv_distribuidora_permisos": {
      ".read": "(auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin') || (auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'distribuidora')",
      ".write": "auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin'",
      "chat": {
        ".validate": "newData.isBoolean()"
      },
      "detalle": {
        ".validate": "newData.isBoolean()"
      },
      "editar": {
        ".validate": "newData.isBoolean()"
      },
      "crear": {
        ".validate": "newData.isBoolean()"
      },
      "$otro": {
        ".validate": false
      }
    },
    "sv_distribuidora_auditoria": {
      ".read": "auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'admin'",
      "$registro": {
        ".write": "auth != null && root.child('sv_chat_roles').child(auth.uid).child('activo').val() === true && root.child('sv_chat_roles').child(auth.uid).child('rol').val() === 'distribuidora' && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid','producto','accion','fecha','campos'])",
        "uid": {
          ".validate": "newData.isString()"
        },
        "producto": {
          ".validate": "newData.isString()"
        },
        "accion": {
          ".validate": "newData.val() === 'crear' || newData.val() === 'editar'"
        },
        "fecha": {
          ".validate": "newData.isNumber() && newData.val() <= now + 300000 && newData.val() >= now - 300000"
        },
        "campos": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "$otro": {
          ".validate": false
        }
      }
    }
  }
}
